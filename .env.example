# ─── MongoDB ────────────────────────────────────────────
# The database name lives here and NOWHERE else in the codebase.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=app

# Surfaces in the Atlas profiler as the source of each query. Set per app.
APP_NAME=web

# ─── Auth (Auth.js v5) ──────────────────────────────────
# Signs both session cookies and completion tokens.
#
# There is deliberately NO fallback for this in code. A missing value crashes
# the process at import rather than silently signing with a default — which is
# how a secret that anyone can read from the source ends up in production.
#
#   openssl rand -base64 32
AUTH_SECRET=

# ─── Email delivery (optional in dev) ───────────────────
# Without RESEND_API_KEY the verification code is printed to the server log in
# development. In production a missing key is a hard failure, not a log line.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ─── OAuth (optional) ───────────────────────────────────
# Each provider registers only if BOTH of its variables are set.
# Callback: {origin}/api/auth/callback/{github|google}
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
