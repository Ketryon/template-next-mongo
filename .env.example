# ─── MongoDB ────────────────────────────────────────────
# The database name lives here and NOWHERE else in the codebase.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=app

# Surfaces in the Atlas profiler as the source of each query. Set per app.
APP_NAME=web

# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Template stub auth (delete once real auth is wired) ─
# apps/web/lib/session.ts falls back to this outside production.
DEV_SESSION_USER_ID=
DEV_SESSION_ROLE=user
