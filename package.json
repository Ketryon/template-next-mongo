{
  "name": "template-next-mongo",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js + MongoDB template \u2014 the data layer is the product",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:indexes": "pnpm --filter @ketryon/db indexes",
    "db:migrate": "pnpm --filter @ketryon/db migrate",
    "clean": "pnpm -r exec rm -rf .next dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server",
      "sharp",
      "unrs-resolver"
    ]
  }
}
