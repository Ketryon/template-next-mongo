{
  "name": "@ketryon/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The data layer. Owns the MongoClient, the schemas, and every query.",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth-store.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "indexes": "tsx src/scripts/sync-indexes.ts",
    "migrate": "tsx src/scripts/migrate.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "mongodb": "^7.7.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv": "^17.4.2",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
